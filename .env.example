# =============================================================================
# SentryOps environment. Copy to `.env` and adjust. NEVER commit your real .env.
# Every value below has a safe local-dev default in docker-compose; override here.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ---- Security / Auth ---------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-48-byte-url-safe-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RATE_LIMIT_AUTH=10/minute          # login / refresh throttle
RATE_LIMIT_SCAN=6/minute           # compliance-scan / manual-run throttle

# ---- Database (psycopg 3 sync driver) ----------------------------------------
DATABASE_URL=postgresql+psycopg://sentryops:sentryops@postgres:5432/sentryops

# ---- Redis / queue -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- CORS (comma-separated origins; locked down by default) ------------------
CORS_ORIGINS=http://localhost:3000

# ---- Observability worker ----------------------------------------------------
HEALTHCHECK_INTERVAL_SECONDS=30    # scheduler tick; each check honors its own interval
INCIDENT_OPEN_THRESHOLD=3          # K consecutive failures -> open incident
INCIDENT_CLOSE_THRESHOLD=2         # M consecutive successes -> resolve/close incident

# ---- AI Incident Triage (Pillar 4) -------------------------------------------
# OFF by default. The app degrades gracefully to "AI triage disabled" with no key.
AI_TRIAGE_ENABLED=false
ANTHROPIC_API_KEY=                 # your own key; required only when AI_TRIAGE_ENABLED=true
ANTHROPIC_MODEL=claude-sonnet-4-6  # one-line swap; never logged
AI_MAX_OUTPUT_TOKENS=1500
AI_DAILY_TOKEN_BUDGET=200000       # hard global cap; triage refuses past this per day
AI_PROMPT_VERSION=v1               # selects app/ai/prompts/system_<version>.md

# ---- Bootstrap admin (used by `make seed` / first run) -----------------------
FIRST_ADMIN_EMAIL=admin@sentryops.local
FIRST_ADMIN_PASSWORD=admin12345
FIRST_VIEWER_EMAIL=viewer@sentryops.local
FIRST_VIEWER_PASSWORD=viewer12345

# ---- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
